{
    "compilerOptions": {
      "target": "ES2020",
      "module": "ESNext",
      "moduleResolution": "bundler",
      "allowJs": true,
      "checkJs": false,
      "strict": false,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "rootDir": "src",
      "outDir": "dist"
    },
    "include": ["src/**/*"]
  }